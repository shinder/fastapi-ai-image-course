# 應用設定
APP_NAME=fastapi-ai-image
DEBUG=true

# PostgreSQL（docker：docker compose up -d 或 ./start-postgres.sh）
# 帳密與資料庫名對應 start-postgres.sh / docker-compose.yml 的 POSTGRES_* 設定
# DATABASE_URL=postgresql+psycopg://postgres:secret@localhost:5432/ai_image_db
# SQLite（免安裝任何服務，最省事的開發選項；預設用這條）
DATABASE_URL=sqlite:///./app.db

# Redis（docker：./start-redis.sh；純記憶體快取，容器重啟即清）
REDIS_URL=redis://localhost:6379/0

# MongoDB（單元九 補充教材；docker：./start-mongodb.sh，未設帳密）
MONGO_URL=mongodb://localhost:27017
MONGO_DB=ai_image_db

# Ollama（單元 6.5 視覺模型；跑在本機，非 docker）
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=gemma3:latest

# OpenAI（選用，僅單元 6.6 影像生成需要）
OPENAI_API_KEY=

# 上傳目錄
UPLOAD_DIR=./uploads
