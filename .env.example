# 應用設定
APP_NAME=my-fastapi
DEBUG=true

# 資料庫（教材 5.3；PostgreSQL 的完整操作見附錄 F）
# 預設 SQLite：免安裝任何服務，開箱即可跑
DATABASE_URL=sqlite:///./app.db
# 改用 PostgreSQL 時，啟動容器後把上面註解掉、改用這條
# 帳密與資料庫名對應 sh-start-postgres.sh / docker-compose.yml 的 POSTGRES_* 設定
# DATABASE_URL=postgresql+psycopg://postgres:secret@localhost:5432/ai_image_db

# Redis（附錄 E；docker：./sh-start-redis.sh，純記憶體快取，容器重啟即清）
REDIS_URL=redis://localhost:6379/0

# MongoDB（單元九 補充教材；docker：./sh-start-mongodb.sh，未設帳密）
MONGO_URL=mongodb://localhost:27017
MONGO_DB=ai_image_db

# Ollama（教材 8.3 視覺模型；跑在本機，非 docker）
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=gemma3:4b

# OpenAI（選用，僅附錄 D 影像生成需要）
OPENAI_API_KEY=

# MediaPipe 手部偵測（教材 8.7；模型檔已隨版控附上，遺失時用 scripts/download_models.py 重新下載）
HAND_MODEL_PATH=./ml_models/hand_landmarker.task
HAND_MAX_NUM=2
HAND_MAX_SIDE=1280
# 附錄 D（H03 串流）：同時允許幾條 WebSocket 連線，每條連線各佔一份模型記憶體
HAND_WS_MAX_CONN=4

# 上傳目錄
UPLOAD_DIR=./uploads
